# Copy this file to `.env.local` and fill in the secret values.
# `.env.local` is gitignored — never commit real secrets.
#
# The VITE_/public Supabase values are already committed in `.env` and are
# safe to expose (they're the browser-side anon key). You only need the
# secrets below to run the server-side features locally.

# ── Required for the app to serve an authenticated request at all ───────
# `requireSupabaseAuth` reads these on every server function, and
# `canKeepDeclarations()` reads them to decide whether the Interested control
# can be offered. Both are public/browser-safe values, not secrets.
#
# Locally they come from the committed `.env` and you do not need to set them.
# **A deployment does not read `.env`** — set them in the hosting environment,
# or every authenticated request fails with
# "Missing Supabase environment variable(s): SUPABASE_URL, SUPABASE_PUBLISHABLE_KEY".
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# The same two values again, prefixed, for the browser bundle.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# ── Required for AI features ────────────────────────────────────────────
# Discovery pipeline, eligibility engine, SOP generator, CV optimizer.
# Get one at https://console.anthropic.com (separate from a Claude subscription).
ANTHROPIC_API_KEY=

# ── Required for admin / server-side DB writes ──────────────────────────
# Supabase Dashboard → Project Settings → API → service_role key.
# Bypasses RLS — server-only, never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ── Optional ────────────────────────────────────────────────────────────
# Canonical site URL used in OG tags, share links, and reminder emails.
# Defaults to https://opportunityx.app when unset.
SITE_URL=
VITE_SITE_URL=

# Live-web scraping for opportunity verification (https://firecrawl.dev).
# Without it, verification falls back to a plain HTTP reachability check.
FIRECRAWL_API_KEY=

# Deadline reminder emails (https://resend.com).
RESEND_API_KEY=

# ── Required before either scheduled job will run ───────────────────────
# The shared secret a scheduler presents as the
# `x-opportunity-x-cron-secret` header on:
#
#   POST /api/public/hooks/crawl-opportunities
#   POST /api/public/hooks/deadline-reminders
#
# Both refuse with 503 while this is unset, and with 401 when the header is
# missing or wrong. That is deliberate: the second endpoint reads every user's
# saved opportunities and sends them email, and an endpoint that mails your
# user base is the wrong place to be permissive by default.
#
# Generate one and keep it long and random — the comparison is constant-time,
# but no comparison hides the length:
#
#   openssl rand -hex 32
#
# A secret. Never give it a VITE_ prefix; that ships it to the browser.
OPPORTUNITY_X_CRON_SECRET=
